{
  "name": "mudrapragyan",
  "version": "0.1.0",
  "private": true,
  "description": "MudraPragyan.AI \u2014 privacy-preserving, on-device sign language recognition",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @mudrapragyan/web",
    "build": "node scripts/setup-assets.mjs --allow-missing && npm run build --workspace @mudrapragyan/core && npm run build --workspace @mudrapragyan/web",
    "preview": "npm run preview --workspace @mudrapragyan/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "setup:assets": "node scripts/setup-assets.mjs",
    "fixtures:parity": "npm run build --workspace @mudrapragyan/core && node scripts/generate-parity-fixtures.mjs",
    "train:synthetic": "cd training && PYTHONPATH=. python3 -m mudra_train.train --synthetic --out ../packages/web/public/models/asl-fingerspell",
    "test:python": "cd training && PYTHONPATH=. python3 -m pytest -q",
    "train:synthetic:ctc": "cd training && PYTHONPATH=. python3 -m mudra_train.train_ctc --synthetic --out ../packages/web/public/models/asl-fingerspell",
    "diagrams": "cd training && PYTHONPATH=. python3 -m mudra_train.export.diagrams --out ../packages/web/public",
    "train:synthetic:words": "cd training && PYTHONPATH=. python3 -m mudra_train.train_words --synthetic --out ../packages/web/public/models/asl-fingerspell"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.2"
  }
}
