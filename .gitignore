# Generated by `npm run setup:assets` (~50 MB). models.lock.json pins them.
# Only the downloaded MediaPipe .task files are ignored — trained model packs
# (models/<pack-id>/) must be committable, or the deployed app silently falls
# back to the v1 legacy pipeline and its correction heuristics.
packages/web/public/mediapipe/
packages/web/public/models/*.task
packages/web/public/ort/

